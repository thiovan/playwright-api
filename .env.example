# Server
PORT=3000
NODE_ENV=production

# Dashboard Admin Authentication
DASHBOARD_ADMIN_USER=admin
DASHBOARD_ADMIN_PASS=admin
SESSION_TTL=604800

# Redis (Local Docker or External Managed Service)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Worker Concurrency
CONCURRENCY=3

# Timeouts (milliseconds)
ACTION_TIMEOUT=60000
WORKFLOW_TIMEOUT=300000
WEBHOOK_TIMEOUT=30000
LOOP_MAX_ITERATIONS=1000

# Queue & History
QUEUE_NAME=playwright-workflows
HISTORY_TTL=86400
HISTORY_MAX_ITEMS=1000

# VNC Remote Display (Port 8080 by default in entrypoint.sh)
VNC_HOST=localhost
VNC_PORT=8080
DISPLAY=:99

# Screen Recordings for Debugging (headless: false)
RECORDINGS_DIR=recordings
RECORDINGS_TTL=86400
